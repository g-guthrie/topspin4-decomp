/*
 * ts4core tunable registry (X-macro). Single source of truth for:
 *   - the C enum Ts4Tun and the name table (src/data.c),
 *   - docs/port/data-format.md (section "Tunable registry"),
 *   - port/core/tools/ts4d.py (parses the TS4_TUN lines with a regex, so keep one entry per line).
 *
 * TS4_TUN(ID, "name", "unit", ORIGIN, REQ, "source / meaning")
 *
 *   key in the TUNE section = zlib.crc32(name as ASCII)   (same hash family the game uses)
 *   ORIGIN  GAME  value lives in the game's data or code constants; the export tools should fill it
 *                 ("where" is in the last column; "loc U" = location not yet decoded)
 *           PORT  value invented by the port (no counterpart in the game, or not decoded yet);
 *                 shipped in port/core/data/provisional.tunables.json, never presented as the game's value
 *   REQ     R     the module that uses it will not start without it (listed by ts4_missing_tunable())
 *           O     optional; code checks ts4_has_tunable() and degrades
 *
 * Nothing in the C sources carries a default for any of these.
 */

/* ---- ball model (docs/gameplay/gp4b.md section 7; gp4.md) ---- */
TS4_TUN(BALL_RADIUS_CM,       "ball.radius_cm",        "cm",     GAME, R, "ball+0x4D0; writer not located (gp4b s7)")
TS4_TUN(BALL_A4,              "ball.a4",               "s",      GAME, R, "ball+0x4D4 drag time constant; k = T / a4; loc U")
TS4_TUN(BALL_G,               "ball.g",                "m/s^2",  GAME, R, "ball+0x4D8 gravity; loc U")
TS4_TUN(BALL_MAX_BOUNCES,     "ball.max_bounces",      "count",  GAME, R, "ball+0x4DC; fn_886B1BA0+0x2178 stores 10")
TS4_TUN(BALL_NET_HEIGHT_CM,   "ball.net_height_cm",    "cm",     GAME, R, "ball+0x124 / cfg+0x124 net height at the crossing")
TS4_TUN(BALL_NET_RESTITUTION, "ball.net_restitution",  "ratio",  GAME, R, "pool+0x10C = 0.2 (velocity factor after a solid net hit)")
TS4_TUN(BALL_CORD_ANGLE_A,    "ball.cord_angle_a_deg", "deg",    GAME, R, "ball+0x494 net-cord deflection (gp4 s1.4)")
TS4_TUN(BALL_CORD_ANGLE_B,    "ball.cord_angle_b_deg", "deg",    GAME, R, "ball+0x498 net-cord deflection")
TS4_TUN(BALL_CORD_SPEED_LOSS, "ball.cord_speed_loss",  "ratio",  GAME, R, "ball+0x49C")
TS4_TUN(BALL_CORD_SPIN_LOSS,  "ball.cord_spin_loss",   "ratio",  GAME, R, "ball+0x4A0")
TS4_TUN(BALL_DISP_X_LO,       "ball.disp_x_lo_cm",     "cm",     GAME, R, "ball+0x4C0 landing dispersion box (gp4b s10.3)")
TS4_TUN(BALL_DISP_X_HI,       "ball.disp_x_hi_cm",     "cm",     GAME, R, "ball+0x4C4")
TS4_TUN(BALL_DISP_Z_LO,       "ball.disp_z_lo_cm",     "cm",     GAME, R, "ball+0x4C8")
TS4_TUN(BALL_DISP_Z_HI,       "ball.disp_z_hi_cm",     "cm",     GAME, R, "ball+0x4CC")

/* ---- court (line positions; the 2*radius tolerance of gp4b s10.3 is applied in code) ---- */
TS4_TUN(COURT_HALF_LENGTH_CM, "court.half_length_cm",  "cm",     PORT, R, "baseline |x|; gp4b s10.3 lists 1194.5 incl. tolerance (pool const)")
TS4_TUN(COURT_HALF_WIDTH_S_CM,"court.half_width_singles_cm","cm", PORT, R, "singles sideline |z|; gp4b s10.3 lists 415.5 incl. tolerance")
TS4_TUN(COURT_HALF_WIDTH_D_CM,"court.half_width_doubles_cm","cm", PORT, R, "doubles sideline |z|; gp4b s10.3 lists 552.5")
TS4_TUN(COURT_SERVICE_X_CM,   "court.service_line_cm", "cm",     PORT, R, "service line |x|; gp4b s10.3 lists 646.0")

/* ---- shot decision / launch (gp4b s10, shot-to-template.md) ---- */
