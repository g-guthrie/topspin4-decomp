TS4_TUN(SHOT_ERR_ADD,         "shot.error_added",      "0..1",   PORT, R, "initial S+0x564")
TS4_TUN(SHOT_LET_PROB,        "shot.let_prob",         "0..1",   PORT, R, "initial S+0x71C (graph LET refines it)")
TS4_TUN(SHOT_NET_SHARE,       "shot.net_share",        "0..1",   PORT, R, "initial S+0x720: share of errors that are Net")
TS4_TUN(SHOT_SPIN_BLEND,      "shot.spin_blend",       "0..1",   PORT, R, "initial S+0x774 (spin lerp between template lo/hi)")
TS4_TUN(SHOT_F4C,             "shot.f4c",              "0..1",   PORT, R, "initial S+0x778 (secondary stage weight w = 1 - f4C)")
TS4_TUN(SHOT_NET_LET_ENABLED, "shot.net_let_enabled",  "0/1",    PORT, R, "gate G of gp4b s10.2 (bytes match+0x328/0x329 meaning unknown)")

