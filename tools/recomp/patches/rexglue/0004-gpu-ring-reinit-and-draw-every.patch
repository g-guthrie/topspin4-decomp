+namespace {
+// Local patch (Top Spin 4 bring-up): REX_DRAW_EVERY=N renders only every Nth frame.
+// Skipped frames still execute every packet (register writes, fences, interrupts), so the
+// title runs at simulation speed while the host GPU (lavapipe here) idles. Frames whose
+// swap index is a multiple of N are drawn and presented normally.
+uint32_t DrawEvery() {
+  static const uint32_t n = [] {
+    const char* v = std::getenv("REX_DRAW_EVERY");
+    long x = v ? std::strtol(v, nullptr, 0) : 1;
+    return uint32_t(x > 1 ? x : 1);
+  }();
+  return n;
+}
+}  // namespace
