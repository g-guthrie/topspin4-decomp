 void CommandProcessor::InitializeRingBuffer(uint32_t ptr, uint32_t size_log2) {
-  read_ptr_index_ = 0;
-  primary_buffer_ptr_ = ptr;
-  primary_buffer_size_ = uint32_t(1) << (size_log2 + 3);
+  // A title that re-initialises the GPU (Top Spin 4: Loader_DLL shuts the engines down and
+  // Swing_DLL starts them again) restarts writing at offset 0. Reset both indices on the
+  // worker thread, between packets, so a stale write index from the previous ring is never
+  // executed against the new buffer.
+  auto reset = [this, ptr, size_log2]() {
+    read_ptr_index_ = 0;
+    write_ptr_index_ = 0;
+    primary_buffer_ptr_ = ptr;
+    primary_buffer_size_ = uint32_t(1) << (size_log2 + 3);
+  };
+  if (!worker_running_ || !worker_thread_ || system::XThread::IsInThread(worker_thread_.get()) ||
+      primary_buffer_ptr_ == 0) {
+    reset();
+    return;
+  }
+  thread::Fence fence;
+  CallInThread([&fence, reset]() {
+    reset();
+    fence.Signal();
+  });
+  write_ptr_index_event_->Set();
+  fence.Wait();
 }
 
