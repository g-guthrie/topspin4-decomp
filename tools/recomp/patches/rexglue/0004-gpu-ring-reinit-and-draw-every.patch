+      primary_buffer_ptr_ == 0) {
+    reset();
+    return;
+  }
+  thread::Fence fence;
+  CallInThread([&fence, reset]() {
+    reset();
+    fence.Signal();
+  });
+  write_ptr_index_event_->Set();
+  fence.Wait();
 }
 
