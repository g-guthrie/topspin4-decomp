+namespace {
+// Local patch (Top Spin 4 bring-up): REX_DRAW_EVERY=N renders only every Nth frame.
+// Skipped frames still execute every packet (register writes, fences, interrupts), so the
+// title runs at simulation speed while the host GPU (lavapipe here) idles. Frames whose
+// swap index is a multiple of N are drawn and presented normally.
+uint32_t DrawEvery() {
+  static const uint32_t n = [] {
+    const char* v = std::getenv("REX_DRAW_EVERY");
+    long x = v ? std::strtol(v, nullptr, 0) : 1;
+    return uint32_t(x > 1 ? x : 1);
+  }();
+  return n;
+}
+// REX_DRAW_WINDOW=K: with REX_DRAW_EVERY=N, render the last K frames of every N (default 1),
+// so caches that a title refreshes over several frames are current in the captured frame.
+bool DrawThisFrame(uint32_t next_swap) {
+  static const uint32_t k = [] {
+    const char* v = std::getenv("REX_DRAW_WINDOW");
+    long x = v ? std::strtol(v, nullptr, 0) : 1;
+    return uint32_t(x > 1 ? x : 1);
+  }();
+  uint32_t n = DrawEvery();
+  return n <= 1 || next_swap % n >= n - (k < n ? k : n);
+}
+// Swap packets executed by the GPU worker. counter_ cannot be used for frame selection: it also
+// advances on every host vblank (GraphicsSystem::MarkVblank), so a slow title frame spans several
+// counter_ values and a window keyed on counter_ draws the final copy of a frame whose scene draws
+// were skipped (black output).
+uint32_t g_rc2_swaps = 0;
+// RC2 debug: REX_SKIP_DRAWS=A:B skips draw packets A..B (1-based, inclusive) of every frame
+// after swap REX_SKIP_DRAWS_FROM (default 600); used to bisect which pass blackens a frame.
+uint32_t g_rc2_draw_in_frame = 0;
+bool SkipDrawForBisect(uint32_t swap, uint32_t draw_index) {
+  static const uint32_t from = [] {
+    const char* v = std::getenv("REX_SKIP_DRAWS_FROM");
+    return v ? uint32_t(std::strtoul(v, nullptr, 0)) : 600u;
+  }();
+  static const std::pair<uint32_t, uint32_t> r = [] {
+    const char* v = std::getenv("REX_SKIP_DRAWS");
+    if (!v) return std::pair<uint32_t, uint32_t>(1, 0);
+    char* end;
+    uint32_t a = uint32_t(std::strtoul(v, &end, 0));
+    uint32_t b = *end == ':' ? uint32_t(std::strtoul(end + 1, nullptr, 0)) : a;
+    return std::pair<uint32_t, uint32_t>(a, b);
+  }();
+  return swap >= from && draw_index >= r.first && draw_index <= r.second;
+}
+// RC2 debug: REX_FRAME_TRACE=FIRST:COUNT logs every draw, copy and swap the GPU executes in
+// swaps [FIRST, FIRST+COUNT) (only frames that are drawn when REX_DRAW_EVERY is set).
+bool FrameTraced(uint32_t swap) {
+  static const std::pair<uint32_t, uint32_t> range = [] {
+    const char* v = std::getenv("REX_FRAME_TRACE");
+    if (!v) return std::pair<uint32_t, uint32_t>(0, 0);
+    char* end;
+    uint32_t a = uint32_t(std::strtoul(v, &end, 0));
+    uint32_t n = *end == ':' ? uint32_t(std::strtoul(end + 1, nullptr, 0)) : 1;
+    return std::pair<uint32_t, uint32_t>(a, n);
+  }();
+  return range.second && swap >= range.first && swap - range.first < range.second;
+}
+}  // namespace
