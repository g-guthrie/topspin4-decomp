diff --git a/include/rex/import_trace.h b/include/rex/import_trace.h
new file mode 100644
index 0000000..eda9e23
--- /dev/null
+++ b/include/rex/import_trace.h
@@ -0,0 +1,35 @@
+/**
+ * @file        import_trace.h
+ * @brief       Per-import call counters (local patch for the Top Spin 4 bring-up)
+ *
+ * Every REX_HOOK / REX_STUB body bumps a counter keyed by the import name. The
+ * first call of each import is logged once. DumpImportCounts writes
+ * "count<TAB>name" lines, most-called first.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::trace {
+
+struct ImportCounter {
+  const char* name;
+  std::atomic<uint64_t> count{0};
+  ImportCounter* next = nullptr;
+};
+
+ImportCounter* RegisterImportCounter(const char* name);
+void OnFirstImportCall(ImportCounter* counter);
+// Returns the number of distinct imports written; label is written as a header line.
+size_t DumpImportCounts(const char* path, const char* label);
+
+}  // namespace rex::trace
+
+#define REX_TRACE_IMPORT(name_literal)                                                       \
+  do {                                                                                     \
+    static ::rex::trace::ImportCounter* _rex_import_counter =                              \
+        ::rex::trace::RegisterImportCounter(name_literal);                                 \
+    if (_rex_import_counter->count.fetch_add(1, std::memory_order_relaxed) == 0)           \
+      ::rex::trace::OnFirstImportCall(_rex_import_counter);                                \
+  } while (0)
