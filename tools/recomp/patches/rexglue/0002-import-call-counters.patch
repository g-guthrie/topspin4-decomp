diff --git a/src/system/import_trace.cpp b/src/system/import_trace.cpp
new file mode 100644
index 0000000..cd56a75
--- /dev/null
+++ b/src/system/import_trace.cpp
@@ -0,0 +1,73 @@
+/**
+ * @file        import_trace.cpp
+ * @brief       Per-import call counters (local patch for the Top Spin 4 bring-up)
+ */
+#include <rex/import_trace.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <rex/logging.h>
+
+namespace rex::trace {
+namespace {
+std::atomic<ImportCounter*> g_head{nullptr};
+std::mutex g_mutex;
+const auto g_start = std::chrono::steady_clock::now();
+}  // namespace
+
+ImportCounter* RegisterImportCounter(const char* name) {
+  auto* c = new ImportCounter();
+  c->name = name;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  c->next = g_head.load(std::memory_order_relaxed);
+  g_head.store(c, std::memory_order_release);
+  return c;
+}
+
+void OnFirstImportCall(ImportCounter* counter) {
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - g_start)
+                .count();
+  REXKRNL_INFO("[import-first] {} t={}ms", counter->name, ms);
+  // REX_IMPORT_TRACE_DIR + REX_IMPORT_SNAPSHOT_ON="__imp__A,__imp__B": when one of the
+  // listed imports is called for the first time, write a snapshot of all counters.
+  const char* dir = std::getenv("REX_IMPORT_TRACE_DIR");
+  const char* on = std::getenv("REX_IMPORT_SNAPSHOT_ON");
+  if (dir && on) {
+    std::string list = std::string(",") + on + ",";
+    std::string key = std::string(",") + counter->name + ",";
+    if (list.find(key) != std::string::npos) {
+      std::string path = std::string(dir) + "/imports_at_" + counter->name + ".tsv";
+      DumpImportCounts(path.c_str(), counter->name);
+    }
+  }
+}
+
+size_t DumpImportCounts(const char* path, const char* label) {
+  std::vector<std::pair<uint64_t, const char*>> rows;
+  for (auto* c = g_head.load(std::memory_order_acquire); c; c = c->next) {
+    uint64_t n = c->count.load(std::memory_order_relaxed);
+    if (n) rows.emplace_back(n, c->name);
+  }
+  std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+    return a.first != b.first ? a.first > b.first : std::string_view(a.second) < b.second;
+  });
+  FILE* f = std::fopen(path, "w");
+  if (!f) return 0;
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - g_start)
+                .count();
+  std::fprintf(f, "# %s t=%lldms distinct=%zu\n", label ? label : "", (long long)ms, rows.size());
+  for (auto& [n, name] : rows) std::fprintf(f, "%llu\t%s\n", (unsigned long long)n, name);
+  std::fclose(f);
+  return rows.size();
+}
+
+}  // namespace rex::trace
