+inline simde__m128i simde_mm_vctuxs(simde__m128 src)
+{
+    alignas(16) float f[4];
+    alignas(16) uint32_t r[4];
+    simde_mm_store_ps(f, src);
+    for (int i = 0; i < 4; i++)
+        r[i] = f[i] != f[i] ? 0 : (f[i] <= 0.0f ? 0 : (f[i] >= 4294967296.0f ? 0xFFFFFFFFu : uint32_t(f[i])));
+    return simde_mm_load_si128((simde__m128i*)r);
+}
