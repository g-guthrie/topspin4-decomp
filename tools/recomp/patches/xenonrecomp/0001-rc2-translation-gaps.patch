+// ---------------------------------------------------------------------------------------------
+// RC2 additions: helpers for the VMX128 D3D pack/unpack forms (vpkd3d128 / vupkd3d128) and
+// vctuxs. Host vector layout is the whole-register byte reversal used throughout this file:
+// guest element e of a 4 x 32-bit vector lives in u32[3 - e]; guest halfword h in u16[7 - h].
+// ---------------------------------------------------------------------------------------------
+
+inline uint32_t PPCAsU32(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+inline float PPCAsF32(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+// float -> Xbox 360 VMX128 float16 (no Inf/NaN; 0x7FFF is the largest magnitude).
+// Identical to the upstream float16_4 expression: |x| > 65504 or NaN -> 0x7FFF, small values
+// become denormals, sign preserved.
+inline uint16_t PPCFloatToHalf(uint32_t bits)
+{
+    float a = PPCAsF32(bits & 0x7FFFFFFF);
+    uint8_t e = (a != a) || (a > 65504.0f) ? 0xFF : uint8_t((bits & 0x7F800000) >> 23);
+    uint16_t m = e != 0xFF ? uint16_t((bits & 0x7FE000) >> 13) : 0;
+    uint16_t h = e != 0xFF ? (e > 0x70 ? uint16_t(((e - 0x70) << 10) + m)
+                                      : (0x71 - e > 31 ? 0 : uint16_t((0x400 + m) >> (0x71 - e))))
+                           : 0x7FFF;
+    return h | uint16_t((bits & 0x80000000) >> 16);
+}
+
+// Xbox 360 float16 -> float bits. Exponent 31 is an ordinary exponent (no Inf/NaN in this
+// format); denormals are converted exactly.
+inline uint32_t PPCHalfToFloat(uint16_t h)
+{
+    uint32_t s = uint32_t(h & 0x8000) << 16;
+    uint32_t e = (h >> 10) & 0x1F;
+    uint32_t m = h & 0x3FF;
+    if (e == 0)
+    {
+        if (m == 0)
+            return s;
+        e = 113;
+        while (!(m & 0x400)) { m <<= 1; --e; }
+        return s | (e << 23) | ((m & 0x3FF) << 13);
+    }
+    return s | ((e + 112) << 23) | (m << 13);
+}
+
+// "3.0 + n" packed integer forms: the integer n sits in the low mantissa bits of a float near 3.0.
+inline int32_t PPCSat16From3(uint32_t bits)
+{
+    int32_t v = int32_t(bits) - 0x40400000;
+    return v > 32767 ? 32767 : (v < -32767 ? -32767 : v);
+}
+
+// D3DCOLOR: x,y,z,w (each 3.0 + [0,255]) -> A8R8G8B8 with A = w, R = x, G = y, B = z.
+inline uint32_t PPCPackD3DColor(const uint32_t* u)
+{
+    static constexpr int shift[4] = { 24, 0, 8, 16 }; // host index 0 = guest w
+    uint32_t out = 0;
+    for (int i = 0; i < 4; i++)
+    {
+        float x = PPCAsF32(u[i]);
+        float hi = PPCAsF32(0x404000FF);
+        float c = !(x >= 3.0f) ? 3.0f : (x > hi ? hi : x);
+        out |= (PPCAsU32(c) & 0xFF) << shift[i];
+    }
+    return out;
+}
+
+inline uint32_t PPCPack2101010(const uint32_t* u)
+{
+    auto clampf = [](uint32_t bits, uint32_t lo, uint32_t hi) {
+        float x = PPCAsF32(bits), l = PPCAsF32(lo), h = PPCAsF32(hi);
+        return PPCAsU32(x < l ? l : (x > h ? h : x));
+    };
+    uint32_t x = clampf(u[3], 0x403FFE01, 0x404001FF) & 0x3FF;
+    uint32_t y = clampf(u[2], 0x403FFE01, 0x404001FF) & 0x3FF;
+    uint32_t z = clampf(u[1], 0x403FFE01, 0x404001FF) & 0x3FF;
+    uint32_t w = clampf(u[0], 0x40400000, 0x40400003) & 0x3;
+    return x | (y << 10) | (z << 20) | (w << 30);
+}
