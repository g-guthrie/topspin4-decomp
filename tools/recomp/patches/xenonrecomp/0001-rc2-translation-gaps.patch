+// RC2: find branches (b/bc/bl, CTR forms included) and switch cases that leave their function
+// and land inside another function rather than on its entry. Each such target T becomes an
+// alternate entry "sub_T" of the containing function: a copy of the container that starts with
+// `goto loc_T;`. The container keeps all its labels, so loops that span T keep working. With
+// every guest register in ctx, a tail call to sub_T is exactly the original jump.
+void Recompiler::FindAlternateEntries()
+{
+    std::vector<const Function*> sorted;
+    for (auto& fn : functions)
+        sorted.push_back(&fn);
+    std::sort(sorted.begin(), sorted.end(), [](auto* a, auto* b) { return a->base < b->base; });
+
+    auto container = [&](uint32_t target) -> const Function*
+        {
+            const Function* best = nullptr;
+            for (auto* fn : sorted)
+            {
+                if (fn->base > target)
+                    break;
+                if (target < fn->base + fn->size && (best == nullptr || fn->size > best->size))
+                    best = fn;
+            }
+            return best;
+        };
+
+    std::map<uint32_t, uint32_t> found; // target -> container base
+    auto consider = [&](const Function& fn, uint32_t target)
+        {
+            if (target >= fn.base && target < fn.base + fn.size)
+                return;
+            auto sym = image.symbols.find(target);
+            if (sym != image.symbols.end() && sym->address == target && sym->type == Symbol_Function)
+                return;
+            if (target == config.longJmpAddress || target == config.setJmpAddress)
+                return;
+            if (const Function* c = container(target))
+                found.emplace(target, c->base);
+        };
+
+    for (auto& fn : functions)
+    {
+        auto* data = (uint32_t*)image.Find(fn.base);
+        if (data == nullptr)
+            continue;
+        for (size_t off = 0; off < fn.size; off += 4)
+        {
+            uint32_t addr = fn.base + off;
+            uint32_t insn = ByteSwap(data[off / 4]);
+            uint32_t op = PPC_OP(insn);
+            if (op == PPC_OP_B)
+                consider(fn, (insn & 2) ? PPC_BI(insn) : addr + PPC_BI(insn));
+            else if (op == PPC_OP_BC)
+                consider(fn, (insn & 2) ? PPC_BD(insn) : addr + PPC_BD(insn));
+        }
+    }
+    for (auto& [bctr, table] : config.switchTables)
+    {
+        const Function* owner = container(bctr);
+        if (owner == nullptr)
+            continue;
+        for (uint32_t label : table.labels)
+            if (label != 0)
+                consider(*owner, label);
+    }
+
+    if (!found.empty() && (config.crRegistersAsLocalVariables || config.nonArgumentRegistersAsLocalVariables ||
+        config.nonVolatileRegistersAsLocalVariables || config.ctrAsLocalVariable || config.xerAsLocalVariable ||
+        config.reservedRegisterAsLocalVariable))
+    {
+        reportError("config", "alternate entries need every register in ctx; disable the *_as_local options");
+    }
+
+    for (auto& [target, base] : found)
+    {
+        auto c = std::find_if(functions.begin(), functions.end(), [&](auto& f) { return f.base == base; });
+        image.symbols.emplace(fmt::format("sub_{:X}", target), target, c->base + c->size - target, Symbol_Function);
+        altEntries[base].push_back(target);
+        ++altEntryCount;
+    }
